#!/usr/bin/env bash

set -euo pipefail

# git-auto-commit-codex.sh
# Generates a commit message from staged changes via Codex CLI, then commits.
#
# Usage:
#   git-auto-commit-codex
#   git-auto-commit-codex --body
#   git-auto-commit-codex --dry-run
#   git-auto-commit-codex --no-color
#   git-auto-commit-codex "<additional context for commit message>"
#   git-auto-commit-codex --body "<additional context for commit message>"
#   git-auto-commit-codex --dry-run "<additional context for commit message>"
#   git-auto-commit-codex --no-color "<additional context for commit message>"
#   git-auto-commit-codex --help

MODEL="${CODEX_MODEL:-gpt-5.3-codex}"
REASONING="${CODEX_REASONING:-low}"
GENERATE_BODY=false
DRY_RUN=false
NO_COLOR=false
CONTEXT_ARGS=()

while (($# > 0)); do
  case "$1" in
  --body)
    GENERATE_BODY=true
    shift
    ;;
  -n | --dry-run)
    DRY_RUN=true
    shift
    ;;
  --no-color)
    NO_COLOR=true
    shift
    ;;
  -h | --help)
    cat <<'EOF'
Usage:
  git-auto-commit-codex [--body] [--dry-run] [--no-color] [additional context...]

Options:
  --body        Ask Codex to generate a commit body in addition to subject
  -n, --dry-run Print generated message/body without committing
  --no-color    Disable ANSI colors in script output
  -h, --help    Show this help
EOF
    exit 0
    ;;
  --)
    shift
    while (($# > 0)); do
      CONTEXT_ARGS+=("$1")
      shift
    done
    ;;
  *)
    CONTEXT_ARGS+=("$1")
    shift
    ;;
  esac
done

ADDITIONAL_CONTEXT="${CONTEXT_ARGS[*]:-}"

USE_COLOR=false
if [[ "$NO_COLOR" == false && -t 1 ]]; then
  USE_COLOR=true
fi

if [[ "$USE_COLOR" == true ]]; then
  COLOR_RESET=$'\033[0m'
  COLOR_HIGHLIGHT=$'\033[1;33m'
  COLOR_LABEL=$'\033[1;36m'
  COLOR_MUTED=$'\033[0;90m'
else
  COLOR_RESET=""
  COLOR_HIGHLIGHT=""
  COLOR_LABEL=""
  COLOR_MUTED=""
fi

if ! command -v codex >/dev/null 2>&1; then
  echo "Error: codex CLI not found in PATH." >&2
  exit 1
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: not inside a git repository." >&2
  exit 1
fi

if [[ -z "$(git diff --cached --name-only)" ]]; then
  echo "No staged changes to commit."
  exit 0
fi

STAGED_FILES="$(git diff --cached --name-only)"
STAGED_DIFF="$(git diff --cached --no-color)"

PROMPT=$(
  if [[ "$GENERATE_BODY" == true ]]; then
    cat <<'EOF'
You are writing a git commit message.

Rules:
- Output a subject and body.
- Subject line: imperative mood, max 72 chars.
- Include one blank line between subject and body.
- Body: 2-4 concise lines explaining what changed and why.
- No prefix like feat:, fix:, chore:, docs:, refactor:, test:, style:, ci:.
- Be specific to staged changes.
- Output ONLY the commit message content.

Staged files:
EOF
  else
    cat <<'EOF'
You are writing a git commit message.

Rules:
- Output exactly ONE line.
- Imperative mood.
- No prefix like feat:, fix:, chore:, docs:, refactor:, test:, style:, ci:.
- Max 72 characters.
- Be specific to staged changes.
- Output ONLY the commit message line.

Staged files:
EOF
  fi
)

RAW_OUTPUT="$(
  {
    printf "%s\n%s\n\n" "$PROMPT" "$STAGED_FILES"

    if [[ -n "$ADDITIONAL_CONTEXT" ]]; then
      printf "Additional context from user:\n%s\n\n" "$ADDITIONAL_CONTEXT"
    fi

    printf "Staged diff:\n%s\n" "$STAGED_DIFF"
  } | codex exec \
    --skip-git-repo-check \
    --ephemeral \
    --sandbox read-only \
    -m "$MODEL" \
    --config "model_reasoning_effort=\"$REASONING\"" \
    2>/dev/null |
    sed 's/\r$//'
)"

if [[ -z "${RAW_OUTPUT:-}" ]]; then
  echo "Error: failed to generate commit message from codex." >&2
  exit 1
fi

SUBJECT="$(printf "%s\n" "$RAW_OUTPUT" | sed '/^[[:space:]]*$/d' | head -n 1)"

if [[ -z "${SUBJECT:-}" ]]; then
  echo "Error: codex output did not contain a valid commit subject." >&2
  exit 1
fi

if [[ "$GENERATE_BODY" == true ]]; then
  BODY="$(
    printf "%s\n" "$RAW_OUTPUT" | awk '
      BEGIN { seen_subject = 0 }
      {
        if (seen_subject == 0) {
          if ($0 ~ /^[[:space:]]*$/) { next }
          seen_subject = 1
          next
        }
        print
      }
    '
  )"

  BODY="$(printf "%s\n" "$BODY" | sed '/^[[:space:]]*$/d')"

  printf "%s%s%s\n" "$COLOR_HIGHLIGHT" "$SUBJECT" "$COLOR_RESET"
  if [[ -n "$BODY" ]]; then
    printf "\n%s%s\n" "$COLOR_RESET" "$BODY"
  else
    printf "%sGenerated body: (empty)%s\n" "$COLOR_MUTED" "$COLOR_RESET"
  fi

  if [[ "$DRY_RUN" == true ]]; then
    printf "%sDry run enabled: skipping git commit.%s\n" "$COLOR_MUTED" "$COLOR_RESET" >&2
  else
    if [[ -n "$BODY" ]]; then
      git commit -m "$SUBJECT" -m "$BODY"
    else
      git commit -m "$SUBJECT"
    fi
  fi
else
  printf "%s%s%s\n" "$COLOR_HIGHLIGHT" "$SUBJECT" "$COLOR_RESET"

  if [[ "$DRY_RUN" == true ]]; then
    printf "%sDry run enabled: skipping git commit.%s\n" "$COLOR_MUTED" "$COLOR_RESET" >&2
  else
    git commit -m "$SUBJECT"
  fi
fi
