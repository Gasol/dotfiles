root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Tabs: shell, Makefile and JSON follow what the repo already uses.
[{Makefile,*.sh,*.json,bash/**,scripts/bin/*}]
indent_style = tab

# zsh is outside shfmt and shellcheck, so keep its existing 4 spaces.
[scripts/bin/agent-git-trees.sh]
indent_style = space
indent_size = 4

# Matches config/dot-config/nvim/stylua.toml, which stylua reads first.
[*.lua]
indent_style = space
indent_size = 2
max_line_length = 120

[*.{py,php}]
indent_style = space
indent_size = 4
